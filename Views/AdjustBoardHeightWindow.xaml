<Window x:Class="RBLAOI.Views.AdjustBoardHeightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RBLAOI.Core.Controls"
        Title="调整轨宽" Height="260" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeText}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TitleBarControl Grid.Row="0"
                                  Title="调整轨宽"
                                  TitleIcon="📏"/>

        <Grid Grid.Row="1" Margin="16,10,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 板宽输入（只读） -->
            <Border Grid.Row="0" Background="{DynamicResource ThemePanelBg}" CornerRadius="5" Padding="10" Margin="0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="板宽：" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ThemeText}"/>
                    <TextBox x:Name="txtBoardLength" Grid.Column="1" Height="35"
                             Background="{DynamicResource ThemePanelBg}"
                             Foreground="{DynamicResource ThemeTextSecondary}"
                             BorderBrush="{DynamicResource ThemeBorder}"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             IsReadOnly="True"/>
                    <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource ThemeTextSecondary}"/>
                </Grid>
            </Border>

            <!-- 板高输入 -->
            <Border Grid.Row="1" Background="{DynamicResource ThemePanelBg}" CornerRadius="5" Padding="10" Margin="0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="板高：" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ThemeText}"/>
                    <TextBox x:Name="txtBoardWidth" Grid.Column="1" Height="35"
                             Background="{DynamicResource ThemePanelBg}"
                             Foreground="{DynamicResource ThemeText}"
                             BorderBrush="{DynamicResource ThemeBorder}"
                             VerticalContentAlignment="Center"
                             FontSize="14"/>
                    <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource ThemeTextSecondary}"/>
                </Grid>
            </Border>

            <!-- 提示信息 -->
            <TextBlock Grid.Row="2" Text="输入后点击确定，将自动调整轨道宽度（H轴）"
                       FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}"
                       HorizontalAlignment="Center" Margin="0,10,0,10"/>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="btnConfirm" Content="确定" Margin="0,0,10,0"
                       
                        Style="{StaticResource CommonRadiusButtonStyle}"
                        Click="BtnConfirm_Click"/>

                <Button x:Name="btnCancel" Content="取消"
                        Style="{StaticResource CommonRadiusButtonStyle}"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
