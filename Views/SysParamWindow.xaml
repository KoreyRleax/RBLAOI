<Window x:Class="RBLAOI.Views.SysParamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RBLAOI.Core.Controls"
        Title="系统参数设置" Height="750" Width="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeText}">

    <Window.Resources>


        <!-- 勾选框样式 -->
        <Style x:Key="ParamCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 连接按钮样式（保留原样） -->
        <Style x:Key="ConnectButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF409C72"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF1E5A42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态指示器样式 -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- UniformGrid 内 LabeledTextBox 的统一样式（设置间距） -->
        <Style TargetType="controls:LabeledTextBox" x:Key="UniformLabelStyle">
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="TextBoxWidth" Value="90"/>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:TitleBarControl Grid.Row="0" Title="系统参数设置" TitleIcon="⚙️"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左列 -->
                    <StackPanel Grid.Column="0" Margin="0,0,5,0">

                        <!-- 相机参数 -->
                        <GroupBox Header="📷 相机参数" Style="{StaticResource ThemedGroupBoxStyle}">
                            <StackPanel>
                                <!-- 第一行：曝光时间、保存路径生效延时、到位拍照延时 -->
                                <UniformGrid Columns="3" HorizontalAlignment="Center" >
                                    <controls:LabeledTextBox LabelText="相机曝光时间 (μs)" Text="{Binding CameraExposureTime}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                    <controls:LabeledTextBox LabelText="保存路径生效延时 (ms)" Text="{Binding SetVmSavePathDelay}" Mode="Top" Style="{StaticResource UniformLabelStyle}"  TextBoxWidth="105"/>
                                    <controls:LabeledTextBox LabelText="到位拍照延时 (ms)" Text="{Binding PositionSnapshotDelay}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                </UniformGrid>

                                <!-- 第二行：排料阻挡延时、排料超时、像素密度 -->
                                <UniformGrid Columns="3" HorizontalAlignment="Center">
                                    <controls:LabeledTextBox LabelText="排料阻挡升起延时" Text="{Binding MaterialDischargeBlockDelay}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                    <controls:LabeledTextBox LabelText="排料超时报警延时" Text="{Binding MaterialDischargeTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                    <controls:LabeledTextBox LabelText="像素密度 (px/mm)" Text="{Binding CameraPixelDensity}" Mode="Top" Style="{StaticResource UniformLabelStyle}" />
                                </UniformGrid>

                                <!-- 第三行：相机分辨率 -->
                                <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <controls:LabeledTextBox LabelText="分辨率宽 (px)" Text="{Binding CameraResolutionW}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                    <controls:LabeledTextBox LabelText="分辨率高 (px)" Text="{Binding CameraResolutionH}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                </UniformGrid>

                                <!-- 3D相机偏移 -->
                                <UniformGrid Columns="3" HorizontalAlignment="Center" >
                                    <controls:LabeledTextBox LabelText="3D相机偏移X" Text="{Binding Camera3DOffsetX}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                    <controls:LabeledTextBox LabelText="3D相机偏移Y " Text="{Binding Camera3DOffsetY}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                </UniformGrid>

                                <!-- 3D传感器参数 -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="3D传感器参数" Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,4"/>
                                    <UniformGrid Columns="3" HorizontalAlignment="Center" >
                                        <controls:LabeledTextBox LabelText="传感器FOV宽" Text="{Binding SensorFovWidth}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                        <controls:LabeledTextBox LabelText="传感器FOV高" Text="{Binding SensorFovHeight}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                        <controls:LabeledTextBox LabelText="3D扫描行程(mm)" Text="{Binding Scan3DStroke}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                    </UniformGrid>
                                    <UniformGrid Columns="2" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <controls:LabeledTextBox LabelText="VM转板偏移X(mm)" Text="{Binding VmToBoardOffsetX}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                        <controls:LabeledTextBox LabelText="VM转板偏移Y(mm)" Text="{Binding VmToBoardOffsetY}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- 有效区参数 -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="有效区边界收缩" Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,4"/>
                                    <UniformGrid Columns="3" HorizontalAlignment="Center" >
                                        <controls:LabeledTextBox LabelText="左边界(mm)" Text="{Binding EffAreaLeftShrink}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                        <controls:LabeledTextBox LabelText="右边界(mm)" Text="{Binding EffAreaRightShrink}" Mode="Top" Style="{StaticResource UniformLabelStyle}" TextBoxWidth="105"/>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- 功能开关 -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="功能开关" Foreground="{DynamicResource ThemeSubText}" FontSize="12" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <CheckBox Content="启用扫码" IsChecked="{Binding EnableScanner}" Style="{StaticResource ParamCheckBoxStyle}"/>
                                        <CheckBox Content="启用Mark" IsChecked="{Binding EnableMark}" Style="{StaticResource ParamCheckBoxStyle}"/>
                                        <CheckBox Content="启用报警" IsChecked="{Binding EnableAlarm}" Style="{StaticResource ParamCheckBoxStyle}"/>
                                        <CheckBox Content="启用安全门报警" IsChecked="{Binding EnableSafetyDoorAlarm}" Style="{StaticResource ParamCheckBoxStyle}"/>
                                        <CheckBox Content="启用光幕报警" IsChecked="{Binding EnableLightCurtainAlarm}" Style="{StaticResource ParamCheckBoxStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 检测参数 -->
                        <GroupBox Header="📏 检测参数" Style="{StaticResource ThemedGroupBoxStyle}">
                            <StackPanel>
                                <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="检测方式：" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ThemeText}"/>
                                    <ComboBox ItemsSource="{Binding DetectionModes}" SelectedItem="{Binding DetectionMode}" Width="120"/>
                                </WrapPanel>
                                <UniformGrid Columns="2" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <controls:LabeledTextBox LabelText="精度检测重复次数" Text="{Binding PrecisionRepeatCount}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="空针阈值 (0~1)" Text="{Binding EmptyPinThreshold}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="3D匹配阈值(mm)" Text="{Binding MatchThreshold3D}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="最大重叠率" Text="{Binding MaxOverlap}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 标定 -->
                        <GroupBox Header="📐 标定" Style="{StaticResource ThemedGroupBoxStyle}">
                            <StackPanel>
                                <UniformGrid Columns="2" HorizontalAlignment="Center">
                                    <controls:LabeledTextBox LabelText="拼图X补偿 (mm)" Text="{Binding StitchOffsetX}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="拼图Y补偿 (mm)" Text="{Binding StitchOffsetY}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                </UniformGrid>
                                <Button Content="打开标定助手..." Style="{StaticResource CommonRadiusButtonStyle}"
                                        HorizontalAlignment="Center" Margin="0,8,0,4" Width="160"
                                        Click="BtnCalibrate_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- 右列 -->
                    <StackPanel Grid.Column="1" Margin="5,0,0,0">

                        <!-- 运动与全局参数 -->
                        <GroupBox Header="🏃 运动与全局参数" Style="{StaticResource ThemedGroupBoxStyle}">
                            <StackPanel>
                                <UniformGrid Columns="3" HorizontalAlignment="Center">
                                    <controls:LabeledTextBox LabelText="脉冲当量X" Text="{Binding PulseEquivalentX}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="脉冲当量Y" Text="{Binding PulseEquivalentY}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="脉冲当量Z" Text="{Binding PulseEquivalentZ}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="脉冲当量H" Text="{Binding PulseEquivalentH}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="轴速度(mm/s)" Text="{Binding AxisSpeed}" Mode="Top" Style="{StaticResource UniformLabelStyle}" LostFocus="AxisSpeed_LostFocus"/>
                                    <controls:LabeledTextBox LabelText="最大速度(mm/s)" Text="{Binding MaxSpeed}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="右下角X (mm)" Text="{Binding RightBottomX}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="右下角Y (mm)" Text="{Binding RightBottomY}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                </UniformGrid>
                                <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <controls:LabeledTextBox LabelText="3D扫描速度(mm/s)" Text="{Binding Scan3DSpeed}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="H轴最大位置(mm)" Text="{Binding HAxisMaxPosition}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                </UniformGrid>
                                <UniformGrid Columns="2" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <controls:LabeledTextBox LabelText="待机位 X (mm)" Text="{Binding StandbyX}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="待机位 Y (mm)" Text="{Binding StandbyY}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="待机位 Z (mm)" Text="{Binding StandbyZ}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 超时时间 -->
                        <GroupBox Header="⏱ 超时时间" Style="{StaticResource ThemedGroupBoxStyle}">
                            <StackPanel>
                                <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <controls:LabeledTextBox LabelText="检测位中心超时(ms)" Text="{Binding MoveToCenterTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="扫描起点超时(ms)" Text="{Binding MoveToScanStartTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="调整轨宽超时(ms)" Text="{Binding AdjustRailWidthTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="GRAB拍照超时(ms)" Text="{Binding GrabTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="等待3D结果超时(ms)" Text="{Binding Wait3DResultTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="3D扫描超时(ms)" Text="{Binding Scan3DTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="3D重试超时(ms)" Text="{Binding Scan3DRetryTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="Z轴调焦超时(ms)" Text="{Binding MoveZTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="回零超时(ms)" Text="{Binding AxisHomeTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="等待VM存图超时(ms)" Text="{Binding WaitForVmSaveTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <!-- 连接管理 -->
                        <GroupBox Header="🔗 连接管理" Style="{StaticResource ThemedGroupBoxStyle}">
                            <StackPanel>
                                <!-- 2D视觉连接 -->
                                <Border Background="{DynamicResource ThemePanelBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="2D相机" FontSize="13" FontWeight="SemiBold" Width="80"
                               Foreground="{DynamicResource ThemeText}"/>
                                            <TextBlock Text="{Binding VisionStatusText}" Style="{StaticResource StatusTextStyle}"
                               Foreground="{Binding VisionTextColor}"/>
                                        </StackPanel>
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <controls:LabeledTextBox Grid.Column="0" LabelText="IP地址" Text="{Binding VisionIp}"
                                             IsEnabled="{Binding IsVisionControlsEnabled}"
                                             Mode="Left" />

                                            <controls:LabeledTextBox Grid.Column="1" LabelText="端口" Text="{Binding VisionPort}"
                                             IsEnabled="{Binding IsVisionControlsEnabled}"
                                             Mode="Left"   HorizontalAlignment="Center"/>

                                            <Button Grid.Column="2" Content="{Binding VisionButtonText}" Background="{Binding VisionButtonColor}"
                            Foreground="White" Style="{StaticResource ConnectButtonStyle}" Width="80"
                            VerticalAlignment="Bottom" Margin="0,0,0,0"
                            Click="BtnTestVision_Click"/>

                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 3D视觉连接 -->
                                <Border Background="{DynamicResource ThemePanelBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="3D相机" FontSize="13" FontWeight="SemiBold" Width="80"
                               Foreground="{DynamicResource ThemeText}"/>
                                            <TextBlock Text="{Binding Vision3DStatusText}" Style="{StaticResource StatusTextStyle}"
                               Foreground="{Binding Vision3DTextColor}"/>
                                        </StackPanel>
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:LabeledTextBox Grid.Column="0" LabelText="IP地址" Text="{Binding Vision3DIp}"
                                             IsEnabled="{Binding IsVision3DControlsEnabled}"
                                             Mode="Left" />

                                            <controls:LabeledTextBox Grid.Column="1" LabelText="端口" Text="{Binding Vision3DPort}"
                                             IsEnabled="{Binding IsVision3DControlsEnabled}"
                                             Mode="Left"  HorizontalAlignment="Center" />
                                            <Button Grid.Column="2" Content="{Binding Vision3DButtonText}" Background="{Binding Vision3DButtonColor}"
                            Foreground="White" Style="{StaticResource ConnectButtonStyle}" Width="80"
                            VerticalAlignment="Bottom" Margin="0,0,0,0"
                            Click="BtnTestVision3D_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 下位机连接 -->
                                <Border Background="{DynamicResource ThemePanelBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="下位机" FontSize="13" FontWeight="SemiBold" Width="80"
                               Foreground="{DynamicResource ThemeText}"/>
                                            <TextBlock Text="{Binding SerialStatusText}" Style="{StaticResource StatusTextStyle}"
                               Foreground="{Binding SerialTextColor}"/>
                                        </StackPanel>
                                        <Grid Margin="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:LabeledTextBox Grid.Column="0" LabelText="串口号" Text="{Binding SelectedSerialPort}"
                                             IsEnabled="{Binding IsSerialControlsEnabled}"
                                             Mode="Left" />
                                            <controls:LabeledTextBox Grid.Column="1" LabelText="波特率" Text="{Binding SelectedBaudRate}"
                                             IsEnabled="{Binding IsSerialControlsEnabled}"
                                             Mode="Left" />
                                            <Button Grid.Column="2" Content="{Binding SerialButtonText}" Background="{Binding SerialButtonColor}"
                            Foreground="White" Style="{StaticResource ConnectButtonStyle}" Width="80"
                            VerticalAlignment="Bottom" Margin="0,0,0,0"
                            Click="BtnTestSerial_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 光源控制连接（串口号/波特率/通道数为系统参数，所有方案共用） -->
                                <Border Background="{DynamicResource ThemePanelBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="光源控制" FontSize="13" FontWeight="SemiBold" Width="80"
                               Foreground="{DynamicResource ThemeText}"/>
                                            <TextBlock Text="{Binding LightStatusText}" Style="{StaticResource StatusTextStyle}"
                               Foreground="{Binding LightTextColor}"/>
                                        </StackPanel>
                                        <Grid Margin="5">
                                            <!-- 3列布局与下位机完全一致：串口号/波特率/按钮（通道数移至"其他"分组） -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:LabeledTextBox Grid.Column="0" LabelText="串口号" Text="{Binding LightSourceSerialPort}"
                                             IsEnabled="{Binding IsLightControlsEnabled}"
                                             Mode="Left" />
                                            <controls:LabeledTextBox Grid.Column="1" LabelText="波特率" Text="{Binding LightSourceBaudRate}"
                                             IsEnabled="{Binding IsLightControlsEnabled}"
                                             Mode="Left" />
                                            <Button Grid.Column="2" Content="{Binding LightButtonText}" Background="{Binding LightButtonColor}"
                            Foreground="White" Style="{StaticResource ConnectButtonStyle}" Width="80"
                            VerticalAlignment="Bottom" Margin="0,0,0,0"
                            Click="BtnTestLight_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- 其他 -->
                        <GroupBox Header="⚙️ 其他" Style="{StaticResource ThemedGroupBoxStyle}" Margin="0,10,0,0">
                            <StackPanel>
                                <UniformGrid Columns="2" HorizontalAlignment="Center">
                                    <controls:LabeledTextBox LabelText="IO状态轮询间隔 (ms)" Text="{Binding IoPollInterval}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="光源通道数 (2/4)" Text="{Binding LightSourceChannelCount}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                </UniformGrid>
                                <Separator Margin="0,8" Opacity="0.3"/>
                                <!-- 传送带流程时序 -->
                                <UniformGrid Columns="2" HorizontalAlignment="Center">
                                    <controls:LabeledTextBox LabelText="送到入口超时(ms)" Text="{Binding ConveyorToEntryTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="传送到板稳定延时(ms)" Text="{Binding ConveyorBoardStableMs}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="等待板到位超时(ms)" Text="{Binding ConveyorWaitBoardTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="送到出口超时(ms)" Text="{Binding ConveyorToExitTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="出口防堵超时(ms)(连续模式)" Text="{Binding ContinuousOutletClearTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                    <controls:LabeledTextBox LabelText="入口等板超时(ms)(单板/连续)" Text="{Binding ContinuousEntryWaitTimeout}" Mode="Top" Style="{StaticResource UniformLabelStyle}"/>
                                </UniformGrid>
                                <Separator Margin="0,8" Opacity="0.3"/>
                                <!-- VM方案路径已移除，改为方案-VM方案一一映射 -->
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 底部按钮区域 -->
            <Border Grid.Row="2" Padding="20,12,20,12" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnSave" Content="保存" Style="{StaticResource CommonRadiusButtonStyle}" Click="BtnSave_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnExit" Content="退出" Style="{StaticResource CommonRadiusButtonStyle}" Click="BtnExit_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>