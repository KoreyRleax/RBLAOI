<Window x:Class="RBLAOI.Views.PersonalizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RBLAOI.Core.Controls"
        Title="个性化设置" Height="660" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeText}">

    <Window.Resources>
        <Style TargetType="controls:LabeledTextBox" x:Key="PersonalLabelStyle">
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="TextBoxWidth" Value="90"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:TitleBarControl Grid.Row="0" Title="个性化设置" TitleIcon="🎨"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">

                    <!-- 窗口检测结果显示 -->
                    <GroupBox Header="🔍 窗口检测结果显示" Style="{StaticResource ThemedGroupBoxStyle}">
                        <StackPanel>
                            <!-- 文字样式设定 -->
                            <UniformGrid Columns="2" HorizontalAlignment="Center">
                                <controls:LabeledTextBox LabelText="文字偏移X" Text="{Binding TextOffsetX}" Mode="Top" Style="{StaticResource PersonalLabelStyle}"/>
                                <controls:LabeledTextBox LabelText="文字偏移Y" Text="{Binding TextOffsetY}" Mode="Top" Style="{StaticResource PersonalLabelStyle}"/>
                                <controls:LabeledTextBox LabelText="结果字号" Text="{Binding OverlayFontSize}" Mode="Top" Style="{StaticResource PersonalLabelStyle}"/>
                                <controls:LabeledTextBox LabelText="标记字号" Text="{Binding MarkerFontSize}" Mode="Top" Style="{StaticResource PersonalLabelStyle}"/>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="字体" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding OverlayFontName}" Width="160" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="显示方向" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <ComboBox ItemsSource="{Binding TextDirectionOptions}" SelectedItem="{Binding TextDirection}" Width="140" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- 颜色设定 -->
                            <TextBlock Text="━━━ 颜色设定 ━━━" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <UniformGrid Columns="2" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="焊盘定位框颜色" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableColors}" SelectedValue="{Binding PadColor}" SelectedValuePath="Value" DisplayMemberPath="Display" Width="140" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="针尖定位框颜色" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableColors}" SelectedValue="{Binding PinColor}" SelectedValuePath="Value" DisplayMemberPath="Display" Width="140" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="理想针框颜色" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableColors}" SelectedValue="{Binding IdealPinColor}" SelectedValuePath="Value" DisplayMemberPath="Display" Width="140" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="文字背景色" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <ComboBox ItemsSource="{Binding BgColorOptions}" SelectedValue="{Binding TextBgColor}" SelectedValuePath="Value" DisplayMemberPath="Display" Width="140" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="空针框颜色" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableColors}" SelectedValue="{Binding EmptyPinColor}" SelectedValuePath="Value" DisplayMemberPath="Display" Width="140" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="理想针圆点半径(像素)" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <controls:LabeledTextBox LabelText="" Text="{Binding IdealPinDotRadius}" Mode="Top" Style="{StaticResource PersonalLabelStyle}" Width="140"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- 标注框绘制 -->
                            <TextBlock Text="━━━ 标注框绘制 ━━━" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <UniformGrid Columns="3" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <CheckBox Content="显示焊盘框" IsChecked="{Binding ShowPadBox}" Foreground="{DynamicResource ThemeText}" Margin="10,6" VerticalAlignment="Center"/>
                                <CheckBox Content="显示针尖框" IsChecked="{Binding ShowPinBox}" Foreground="{DynamicResource ThemeText}" Margin="10,6" VerticalAlignment="Center"/>
                                <CheckBox Content="显示理想针框" IsChecked="{Binding ShowIdealPinBox}" Foreground="{DynamicResource ThemeText}" Margin="10,6" VerticalAlignment="Center"/>
                                <CheckBox Content="显示空针框" IsChecked="{Binding ShowEmptyPinBox}" Foreground="{DynamicResource ThemeText}" Margin="10,6" VerticalAlignment="Center"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 检测位选择 -->
                    <GroupBox Header="🎯 检测位选择" Style="{StaticResource ThemedGroupBoxStyle}" Margin="0,10,0,0">
                        <StackPanel>
                            <UniformGrid Columns="2" HorizontalAlignment="Center">
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="选择框颜色" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableColors}" SelectedValue="{Binding SelectionBoxColor}" SelectedValuePath="Value" DisplayMemberPath="Display" Width="140" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <controls:LabeledTextBox LabelText="选择框大小（像素）" Text="{Binding SelectionBoxSize}" Mode="Top" Style="{StaticResource PersonalLabelStyle}"/>
                            </UniformGrid>

                            <!-- 2026-08-27：针型标记（A/B/C...）文字参数 -->
                            <TextBlock Text="━━━ 针型标记文字 ━━━" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <UniformGrid Columns="2" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <controls:LabeledTextBox LabelText="针型字号大小" Text="{Binding MarkerFontSize}" Mode="Top" Style="{StaticResource PersonalLabelStyle}"/>
                                <controls:LabeledTextBox LabelText="针型文字边距" Text="{Binding MarkerTextMargin}" Mode="Top" Style="{StaticResource PersonalLabelStyle}"/>
                                <StackPanel Margin="10,8" VerticalAlignment="Center">
                                    <TextBlock Text="针型文字背景" Foreground="{DynamicResource ThemeText}" FontSize="13" Margin="4,0,4,4"/>
                                    <ComboBox ItemsSource="{Binding BgColorOptions}" SelectedValue="{Binding MarkerTextBgColor}" SelectedValuePath="Value" DisplayMemberPath="Display" Width="140" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮区域 -->
            <Border Grid.Row="2" Padding="20,12,20,12" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnSave" Content="确定" Style="{StaticResource CommonRadiusButtonStyle}" Click="BtnSave_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnExit" Content="取消" Style="{StaticResource CommonRadiusButtonStyle}" Click="BtnExit_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
