<Window x:Class="RBLAOI.Views.AxisIOControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:RBLAOI.Core.Controls"
        mc:Ignorable="d"
        Title="轴/IO控制" Height="900" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource ThemeText}">

    <Window.Resources>
        <!-- 轴控制按钮样式 -->
        <Style x:Key="AxisButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ThemeButton}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeActive}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeHover}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ThemeText}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeActive}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IO按钮样式 -->
        <Style x:Key="IOButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{StaticResource ThemeButton}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ThemeHover}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource ThemeText}"/>
                                <Setter Property="Foreground" Value="{StaticResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 统一面板样式 -->
        <Style x:Key="UnifiedPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ThemeBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 输入状态指示灯样式 -->
        <Style x:Key="IndicatorStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style x:Key="IndicatorRectangleStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="#FF95A5A6"/>
            <Setter Property="RadiusX" Value="2"/>
            <Setter Property="RadiusY" Value="2"/>
        </Style>

        <Style x:Key="IndicatorTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="60"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondary}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource ThemeBg}"
            BorderBrush="{StaticResource ThemeBorder}"
            BorderThickness="1"
            CornerRadius="2">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <controls:TitleBarControl Grid.Row="0"
                          Title="轴与IO控制"
                          TitleIcon="🎮"/>

            <!-- 串口连接栏 -->
            <Border Grid.Row="1" Style="{StaticResource UnifiedPanelStyle}" Margin="10,10,10,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0">
                        <TextBlock Text="串口：" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource ThemeText}"/>
                        <ComboBox x:Name="cmbPort" Width="100" Height="30"
                                  Background="{StaticResource ThemePanelBg}"
                                  Foreground="{StaticResource ThemeText}"
                                  BorderBrush="{StaticResource ThemeBorder}"/>

                        <TextBlock Text="波特率：" VerticalAlignment="Center" FontSize="13" Margin="20,0,10,0" Foreground="{StaticResource ThemeText}"/>
                        <ComboBox x:Name="cmbBaud" Width="100" Height="30" SelectedIndex="2"
                                 Background="{StaticResource ThemePanelBg}"
                                 Foreground="{StaticResource ThemeText}"
                                 BorderBrush="{StaticResource ThemeBorder}">
                            <ComboBoxItem>9600</ComboBoxItem>
                            <ComboBoxItem>115200</ComboBoxItem>
                            <ComboBoxItem>460800</ComboBoxItem>
                        </ComboBox>

                        <Button x:Name="btnConnect" Content="连接" Width="80" Height="32" Margin="30,0,0,0"
                            Background="#FF27AE60" Foreground="White" FontWeight="Bold"
                            Click="BtnConnect_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- 右上角：数据刷新率 + RTT 实时显示 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="刷新率：" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource ThemeSubText}"/>
                        <TextBlock x:Name="txtRefreshRate" Text="--" VerticalAlignment="Center" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource StatusRunning}"/>
                        <TextBlock Text="  RTT：" VerticalAlignment="Center" FontSize="13" Margin="10,0,0,0" Foreground="{StaticResource ThemeSubText}"/>
                        <TextBlock x:Name="txtRtt" Text="--" VerticalAlignment="Center" FontSize="15"
                                   FontWeight="Bold" Foreground="{StaticResource StatusRunning}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主要内容区域 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：轴控制区域 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" Margin="10,10,5,0">
                    <StackPanel>
                        <!-- 轴速度设置 -->
                        <Border Style="{StaticResource UnifiedPanelStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="轴速度(%)：" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource ThemeSubText}"/>
                                <Slider x:Name="AxisSpeedSD" Grid.Column="1" Minimum="1" Maximum="100"
                                        Value="20" SmallChange="1" IsSnapToTickEnabled="True"
                                        TickFrequency="10" TickPlacement="BottomRight"
                                        Foreground="{StaticResource ThemeActive}"
                                        ValueChanged="AxisSpeedSD_ValueChanged"/>
                                <TextBox x:Name="txAxisSpeed" Grid.Column="2" Width="50" Height="25"
                                         TextAlignment="Center" Margin="10,0,0,0"
                                         Background="{StaticResource ThemePanelBg}"
                                         Foreground="{StaticResource ThemeSubText}"
                                         BorderBrush="{StaticResource ThemeBorder}"
                                         Text="{Binding ElementName=AxisSpeedSD, Path=Value, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="3" Content="⟳" Width="28" Height="28" Margin="6,0,0,0"
                                        Background="Transparent" Foreground="{StaticResource ThemeText}"
                                        BorderBrush="{StaticResource ThemeBorder}" BorderThickness="1"
                                        Click="BtnSyncSpeed_Click" Cursor="Hand"
                                        ToolTip="从控制器读取当前速度">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- X轴控制 -->
                        <Border Style="{StaticResource UnifiedPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="X轴" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ThemeText}"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <Rectangle x:Name="rectTestMovingX" Width="12" Height="12" Margin="20,0,0,0"
                                           Fill="#FF95A5A6" ToolTip="X轴运动中" RadiusX="6" RadiusY="6"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnXAdd" Content="←" Style="{StaticResource AxisButtonStyle}"
                                            Width="60" Height="60" Margin="5"
                                            PreviewMouseLeftButtonDown="BtnXAdd_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="BtnXAdd_PreviewMouseUp"/>
                                    <Button x:Name="btnXDel" Content="→" Style="{StaticResource AxisButtonStyle}"
                                            Width="60" Height="60" Margin="5"
                                            PreviewMouseLeftButtonDown="BtnXDel_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="BtnXDel_PreviewMouseUp"/>
                                    <Button x:Name="btnHomeX" Content="X回零" Width="50" Height="30" Margin="5"
                                            Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}"
                                            FontSize="11" FontWeight="Bold"
                                            Click="BtnHomeX_Click" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Rectangle x:Name="rectOrgX" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="X轴原点信号" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="原点" Margin="5,0,15,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                    <Rectangle x:Name="rectLimitXPos" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="X轴正限位" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="X+" Margin="5,0,15,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                    <Rectangle x:Name="rectLimitXNeg" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="X轴负限位" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="X-" Margin="5,0,0,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Y轴控制 -->
                        <Border Style="{StaticResource UnifiedPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Y轴" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ThemeText}"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <Rectangle x:Name="rectTestMovingY" Width="12" Height="12" Margin="20,0,0,0"
                                           Fill="#FF95A5A6" ToolTip="Y轴运动中" RadiusX="6" RadiusY="6"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnYAdd" Content="↑" Style="{StaticResource AxisButtonStyle}"
                                            Width="60" Height="60" Margin="5"
                                            PreviewMouseLeftButtonDown="BtnYAdd_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="BtnYAdd_PreviewMouseUp"/>
                                    <Button x:Name="btnYDel" Content="↓" Style="{StaticResource AxisButtonStyle}"
                                            Width="60" Height="60" Margin="5"
                                            PreviewMouseLeftButtonDown="BtnYDel_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="BtnYDel_PreviewMouseUp"/>
                                    <Button x:Name="btnHomeY" Content="Y回零" Width="50" Height="30" Margin="5"
                                            Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}"
                                            FontSize="11" FontWeight="Bold"
                                            Click="BtnHomeY_Click" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Rectangle x:Name="rectOrgY" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="Y轴原点信号" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="原点" Margin="5,0,15,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                    <Rectangle x:Name="rectLimitYPos" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="Y轴正限位" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="Y+" Margin="5,0,15,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                    <Rectangle x:Name="rectLimitYNeg" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="Y轴负限位" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="Y-" Margin="5,0,0,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Z轴控制 -->
                        <Border Style="{StaticResource UnifiedPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Z轴" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ThemeText}"
                   VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <Rectangle x:Name="rectTestMovingZ" Width="12" Height="12" Margin="20,0,0,0"
                                           Fill="#FF95A5A6" ToolTip="Z轴运动中" RadiusX="6" RadiusY="6"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnCamAdd" Content="↑" Style="{StaticResource AxisButtonStyle}"
                    Width="60" Height="60" Margin="5"
                    PreviewMouseLeftButtonDown="BtnCamAdd_PreviewMouseDown"
                    PreviewMouseLeftButtonUp="BtnCamAdd_PreviewMouseUp"/>
                                    <Button x:Name="btnCamDel" Content="↓" Style="{StaticResource AxisButtonStyle}"
                    Width="60" Height="60" Margin="5"
                    PreviewMouseLeftButtonDown="BtnCamDel_PreviewMouseDown"
                    PreviewMouseLeftButtonUp="BtnCamDel_PreviewMouseUp"/>
                                    <Button x:Name="btnHomeZ" Content="Z回零" Width="50" Height="30" Margin="5"
                                            Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}"
                                            FontSize="11" FontWeight="Bold"
                                            Click="BtnHomeZ_Click" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Rectangle x:Name="rectOrgZ" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="Z轴原点" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="原点" Margin="5,0,15,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                    <!-- 新增 Z 轴限位 -->
                                    <Rectangle x:Name="rectLimitZPos" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="Z轴正限位" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="Z+" Margin="5,0,15,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                    <Rectangle x:Name="rectLimitZNeg" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="Z轴负限位" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="Z-" Margin="5,0,0,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- H轴控制 -->
                        <Border Style="{StaticResource UnifiedPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="H轴" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ThemeText}"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <Rectangle x:Name="rectTestMovingH" Width="12" Height="12" Margin="20,0,0,0"
                                           Fill="#FF95A5A6" ToolTip="H轴运动中" RadiusX="6" RadiusY="6"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="btnLineAdd" Content="↑" Style="{StaticResource AxisButtonStyle}"
                                            Width="60" Height="60" Margin="5"
                                            PreviewMouseLeftButtonDown="BtnLineAdd_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="BtnLineAdd_PreviewMouseUp"/>
                                    <Button x:Name="btnLineDel" Content="↓" Style="{StaticResource AxisButtonStyle}"
                                            Width="60" Height="60" Margin="5"
                                            PreviewMouseLeftButtonDown="BtnLineDel_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="BtnLineDel_PreviewMouseUp"/>
                                    <Button x:Name="btnHomeH" Content="H回零" Width="50" Height="30" Margin="5"
                                            Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}"
                                            FontSize="11" FontWeight="Bold"
                                            Click="BtnHomeH_Click" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Rectangle x:Name="rectOrgH" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="H轴原点信号" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="原点" Margin="5,0,15,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                    <Rectangle x:Name="rectLimitHPos" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="H轴正限位" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="H+" Margin="5,0,15,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                    <Rectangle x:Name="rectLimitHNeg" Width="12" Height="12" Fill="#FF95A5A6" ToolTip="H轴负限位" RadiusX="6" RadiusY="6"/>
                                    <TextBlock Text="H-" Margin="5,0,0,0" FontSize="11" Foreground="{StaticResource ThemeTextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 快捷操作按钮 -->
                        <Border Style="{StaticResource UnifiedPanelStyle}">
                            <UniformGrid Columns="4" Rows="1" HorizontalAlignment="Stretch">
                                <Button x:Name="btnHome" Content="🔄 回零" Height="40" Margin="3"
                                        Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}" FontWeight="Bold"
                                        Click="BtnHome_Click" Cursor="Hand"/>
                                <Button x:Name="btnStop" Content="⏹️ 急停" Height="40" Margin="3" IsEnabled="False"
                                        ToolTip="软件急停未提供（F407 无 PC 全局 STOP，RESTART 不是停止命令）&#x0a;真正的急停请使用独立硬件安全链（直接切断伺服驱动器电源）"
                                        Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}" FontWeight="Bold"
                                        Click="BtnStop_Click" Cursor="Hand"/>
                                <Button x:Name="btnReset" Content="🔧 复位" Height="40" Margin="3"
                                        Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}" FontWeight="Bold"
                                        Click="BtnReset_Click" Cursor="Hand"/>
                                <Button x:Name="btnRestart" Content="🔁 重启" Height="40" Margin="3"
                                        Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}" FontWeight="Bold"
                                        Click="BtnRestart_Click" Cursor="Hand"/>
                            </UniformGrid>
                        </Border>

                        <!-- 当前位置表格 -->
                        <Border Style="{StaticResource UnifiedPanelStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="📍 当前位置" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"
                                           Foreground="{StaticResource ThemeSubText}"/>

                                <!-- 表头 -->
                                <Border  Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="X轴" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource ThemeText}" Padding="8,6"/>
                                        <TextBlock Grid.Column="1" Text="Y轴" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource ThemeText}" Padding="8,6"/>
                                        <TextBlock Grid.Column="2" Text="Z轴" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource ThemeText}" Padding="8,6"/>
                                        <TextBlock Grid.Column="3" Text="H轴" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource ThemeText}" Padding="8,6"/>
                                    </Grid>
                                </Border>

                                <!-- 2D相机位置（数值行） -->
                                <TextBlock Text="2D相机" FontSize="11" Foreground="{StaticResource ThemeSubText}" Margin="0,0,0,2"/>
                                <Border >
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="txtXPos" Grid.Column="0" Text="0.000"
                                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource ThemeText}" HorizontalAlignment="Center" Padding="8,4"/>
                                        <TextBlock x:Name="txtYPos" Grid.Column="1" Text="0.000"
                                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource ThemeText}" HorizontalAlignment="Center" Padding="8,4"/>
                                        <TextBlock x:Name="txtZPos" Grid.Column="2" Text="0.000"
                                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource ThemeText}" HorizontalAlignment="Center" Padding="8,4"/>
                                        <TextBlock x:Name="txtHPos" Grid.Column="3" Text="0.000"
                                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource ThemeText}" HorizontalAlignment="Center" Padding="8,4"/>
                                    </Grid>
                                </Border>

                                <!-- 3D相机位置 -->
                                <TextBlock Text="3D相机" FontSize="11" Foreground="{StaticResource ThemeSubText}" Margin="0,6,0,2"/>
                                <Border Background="{StaticResource ThemePanelBg}" CornerRadius="4" Padding="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="X: " Foreground="{StaticResource ThemeSubText}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txt3DCamX" Text="0.000"
                                                       FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource ThemeActive}" Padding="4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Y: " Foreground="{StaticResource ThemeSubText}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="txt3DCamY" Text="0.000"
                                                       FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource ThemeActive}" Padding="4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右侧：IO控制区域 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Hidden" Margin="5,10,10,0">
                    <StackPanel>
                        <!-- 输出控制 -->
                        <Border Style="{StaticResource UnifiedPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="📤 输出控制" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"
                                           Foreground="{StaticResource ThemeText}"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnClamp1" Grid.Row="0" Grid.Column="0" Content="顶板1" Style="{StaticResource IOButtonStyle}" Margin="5" Click="BtnClamp1_Click"/>
                                    <Button x:Name="btnClamp2" Grid.Row="0" Grid.Column="1" Content="顶板2" Style="{StaticResource IOButtonStyle}" Margin="5" Click="BtnClamp2_Click"/>
                                    <Button x:Name="btnBlock" Grid.Row="0" Grid.Column="2" Content="阻挡气缸" Style="{StaticResource IOButtonStyle}" Margin="5" Click="BtnBlock_Click"/>
                                    <Button x:Name="btnMotor" Grid.Row="1" Grid.Column="0" Content="流水线马达" Style="{StaticResource IOButtonStyle}" Margin="5" Click="BtnMotor_Click"/>
                                    <Button x:Name="btnBuzzer" Grid.Row="1" Grid.Column="1" Content="蜂鸣器" Style="{StaticResource IOButtonStyle}" Margin="5" Click="BtnBuzzer_Click"/>
                                    <Button x:Name="btnCamera3DTrigger" Grid.Row="1" Grid.Column="2" Content="3D相机触发" Style="{StaticResource IOButtonStyle}" Margin="5" Click="BtnCamera3DTrigger_Click"/>
                                    <Button x:Name="btnRedLight" Grid.Row="2" Grid.Column="0" Content="红灯" Style="{StaticResource IOButtonStyle}" Margin="5" Click="BtnRedLight_Click"/>
                                    <Button x:Name="btnGreenLight" Grid.Row="2" Grid.Column="1" Content="绿灯" Style="{StaticResource IOButtonStyle}" Margin="5" Click="BtnGreenLight_Click"/>
                                    <Button x:Name="btnYellowLight" Grid.Row="2" Grid.Column="2" Content="黄灯" Style="{StaticResource IOButtonStyle}" Margin="5" Click="BtnYellowLight_Click"/>
                                </Grid>

                                <!-- 输出状态指示灯 -->
                                <Border  Margin="0,0,0,0" Padding="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 第1行 -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource IndicatorStyle}">
                                                <Rectangle x:Name="rectClamp1State" Style="{StaticResource IndicatorRectangleStyle}"/>
                                                <TextBlock Text="顶板1" Style="{StaticResource IndicatorTextStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource IndicatorStyle}">
                                                <Rectangle x:Name="rectClamp2State" Style="{StaticResource IndicatorRectangleStyle}"/>
                                                <TextBlock Text="顶板2" Style="{StaticResource IndicatorTextStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource IndicatorStyle}">
                                                <Rectangle x:Name="rectBlockState" Style="{StaticResource IndicatorRectangleStyle}"/>
                                                <TextBlock Text="阻挡" Style="{StaticResource IndicatorTextStyle}"/>
                                            </StackPanel>

                                            <!-- 第2行 -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource IndicatorStyle}">
                                                <Rectangle x:Name="rectMotorState" Style="{StaticResource IndicatorRectangleStyle}"/>
                                                <TextBlock Text="马达" Style="{StaticResource IndicatorTextStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource IndicatorStyle}">
                                                <Rectangle x:Name="rectRedLightState" Style="{StaticResource IndicatorRectangleStyle}"/>
                                                <TextBlock Text="红灯" Style="{StaticResource IndicatorTextStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource IndicatorStyle}">
                                                <Rectangle x:Name="rectGreenLightState" Style="{StaticResource IndicatorRectangleStyle}"/>
                                                <TextBlock Text="绿灯" Style="{StaticResource IndicatorTextStyle}"/>
                                            </StackPanel>

                                            <!-- 第3行 -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource IndicatorStyle}">
                                                <Rectangle x:Name="rectYellowLightState" Style="{StaticResource IndicatorRectangleStyle}"/>
                                                <TextBlock Text="黄灯" Style="{StaticResource IndicatorTextStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource IndicatorStyle}">
                                                <Rectangle x:Name="rectBuzzerState" Style="{StaticResource IndicatorRectangleStyle}"/>
                                                <TextBlock Text="蜂鸣器" Style="{StaticResource IndicatorTextStyle}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource IndicatorStyle}">
                                                <Rectangle x:Name="rectCamera3DTriggerState" Style="{StaticResource IndicatorRectangleStyle}"/>
                                                <TextBlock Text="3D触发" Style="{StaticResource IndicatorTextStyle}"/>
                                            </StackPanel>



                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 输入信号 -->
                        <Border Style="{StaticResource UnifiedPanelStyle}">
                            <StackPanel>
                                <TextBlock Text="📥 输入信号" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"
                                           Foreground="{StaticResource ThemeText}"/>

                                <!-- 传感器输入（3×3） -->
                                <Border Padding="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectWaitSensor" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="待料位" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectWorkSensor" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="工作位" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectOutputSensor" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="出料位" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectLiftUpSensor" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="顶升上限" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectLiftDownSensor" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="顶升下限" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectAirPressureSensor" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="气压检测" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectEmergencySensor" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="急停" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectSafetyLightSensor" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="安全光幕" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectDoorSwitchSensor" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="门禁开关" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 轴状态（电机板 IO，4×2） -->
                                <TextBlock Text="🛠 轴状态（电机板）" FontSize="12" FontWeight="Bold" Margin="0,16,0,8"
                                           Foreground="{StaticResource ThemeSubText}"/>
                                <Border Padding="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectAlarmX" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="X轴报警" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectAlarmY" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="Y轴报警" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectAlarmZ" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="Z轴报警" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="3" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectAlarmH" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="H轴报警" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectAxisXDone" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="X轴到位" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectAxisYDone" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="Y轴到位" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectAxisZDone" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="Z轴到位" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="3" Style="{StaticResource IndicatorStyle}">
                                            <Rectangle x:Name="rectAxisHDone" Style="{StaticResource IndicatorRectangleStyle}"/>
                                            <TextBlock Text="H轴到位" Style="{StaticResource IndicatorTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 状态栏 -->
            <StatusBar Grid.Row="3" Margin="0,10,0,0" Background="{StaticResource ThemePanelBg}" Foreground="{StaticResource ThemeText}">
                <StatusBarItem>
                    <TextBlock x:Name="txtStatus" Text="● 就绪" Margin="5,0"/>
                </StatusBarItem>
                <Separator Background="{StaticResource ThemeBorder}"/>
                <StatusBarItem>
                    <TextBlock x:Name="txtRxCount" Text="📡 接收: 0 字节" Margin="5,0"/>
                </StatusBarItem>
                <Separator Background="{StaticResource ThemeBorder}"/>
                <StatusBarItem>
                    <TextBlock x:Name="txtMode" Text="🎯 模式: 未知" Margin="5,0"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Border>
</Window>