<Window x:Class="RBLAOI.Views.EditProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RBLAOI.Core.Controls"
        Title="修改方案" Height="720" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeText}">

    <Window.Resources>
        <Style x:Key="EditLabelStyle" TargetType="controls:LabeledTextBox">
            <Setter Property="Margin" Value="12"/>
            <Setter Property="TextBoxWidth" Value="120"/>
        </Style>

        <Style x:Key="PinTypeDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ThemedDataGridStyle}">
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <!-- 整行选中：单击选行不进入编辑，双击单元格才编辑，Tab 键可在行/列间顺畅跳转 -->
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <!-- 选中行配色使用全局标准（ThemedDataGridStyle：浅蓝+黑字） -->
        </Style>

        <!-- 检测参数表格单元格文本：居中 + 字号比全局大3px(18→21) -->
        <Style x:Key="PinTypeTextColumnStyle" TargetType="TextBlock" BasedOn="{StaticResource DataGridTextColumnStyle}">
            <Setter Property="FontSize" Value="21"/>
        </Style>

        <!-- 单元格编辑态样式：与显示态一致（居中+21px）。
             选中行背景为浅蓝，编辑态用深色文字保证对比；鼠标全选选区用深蓝（与浅蓝行背景区分） -->
        <Style x:Key="PinTypeEditingStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF1E1E1E"/>
            <Setter Property="CaretBrush" Value="#FF1E1E1E"/>
            <Setter Property="SelectionBrush" Value="#FF1863DA"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- 移动按钮样式：hover/按下高亮（可感知点击），动作执行中禁用半透明 -->
        <Style x:Key="MoveButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="{DynamicResource ThemeButton}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#FFB8D4F0" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 标准配色：hover/按下用深蓝（与浅蓝选中行/黑白文字均区分） -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1863DA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0F4C81"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:TitleBarControl Grid.Row="0" Title="修改方案" TitleIcon="&#9999;&#65039;"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20">

                    <!-- ========== 基础设定 ========== -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#128230; 基础设定" Foreground="{DynamicResource ThemeText}" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="&#128161; 光源控制" Height="28" Padding="12,0"
                                Background="{DynamicResource ThemeButton}" Foreground="{DynamicResource ThemeText}" FontWeight="Bold"
                                Click="BtnLightControl_Click" Cursor="Hand"/>
                    </Grid>
                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <UniformGrid Columns="5" HorizontalAlignment="Center">
                            <controls:LabeledTextBox LabelText="板宽 (mm)" Text="{Binding BoardWidth, UpdateSourceTrigger=PropertyChanged}" Mode="Top" Style="{StaticResource EditLabelStyle}"/>
                            <controls:LabeledTextBox LabelText="板高 (mm)" Text="{Binding BoardHeight, UpdateSourceTrigger=PropertyChanged}" Mode="Top" Style="{StaticResource EditLabelStyle}"/>
                            <controls:LabeledTextBox LabelText="重叠率 (%)" Text="{Binding Overlap, UpdateSourceTrigger=PropertyChanged}" Mode="Top" Style="{StaticResource EditLabelStyle}"/>
                            <controls:LabeledTextBox LabelText="插件特征个数" Text="{Binding PluginFeatureCount, UpdateSourceTrigger=PropertyChanged}" Mode="Top" Style="{StaticResource EditLabelStyle}"/>
                            <controls:LabeledTextBox LabelText="相机曝光时间 (μs)" Text="{Binding CameraExposureValue, UpdateSourceTrigger=PropertyChanged}" Mode="Top" Style="{StaticResource EditLabelStyle}"/>
                        </UniformGrid>
                    </Border>

                    <!-- ========== 检测参数（多类型针） ========== -->
                    <Grid Margin="0,20,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#128208; 检测参数" Foreground="{DynamicResource ThemeText}" FontSize="14" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="板面焦距 (mm)：" VerticalAlignment="Center" Margin="40,0,8,0" Foreground="{DynamicResource ThemeText}"/>
                        <TextBox Grid.Column="2" Text="{Binding BoardFocusValue, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" Height="30" FontSize="21" TextAlignment="Center" VerticalContentAlignment="Center"
                                 HorizontalAlignment="Left"
                                 Background="{DynamicResource ThemePanelBg}"
                                 Foreground="{DynamicResource ThemeText}"
                                 BorderBrush="{DynamicResource ThemeBorder}"/>
                        <Button Grid.Column="3" x:Name="btnMoveBoardFocus" Content="&#9166;" Style="{StaticResource MoveButtonStyle}"
                                Margin="8,0,0,0" ToolTip="Z轴移到板面焦距" Click="BtnMoveBoardFocus_Click"/>
                    </Grid>
                    <TextBlock Text="修改后立即生效，不影响系统参数。每行对应一种针型的检测参数（单击选中整行，双击单元格编辑）。" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="0,0,0,8"/>
                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <DataGrid ItemsSource="{Binding PinTypeParams}" Style="{StaticResource PinTypeDataGridStyle}" Height="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="标记" Binding="{Binding Label}" IsReadOnly="True" Width="60" ElementStyle="{StaticResource PinTypeTextColumnStyle}" EditingElementStyle="{StaticResource PinTypeEditingStyle}"/>
                                <DataGridTextColumn Header="焦距" Binding="{Binding Focus, StringFormat={}{0:F2}}" Width="100" ElementStyle="{StaticResource PinTypeTextColumnStyle}" EditingElementStyle="{StaticResource PinTypeEditingStyle}"/>
                                <DataGridTextColumn Header="XY偏差" Binding="{Binding XyTolerance, StringFormat={}{0:F3}}" Width="100" ElementStyle="{StaticResource PinTypeTextColumnStyle}" EditingElementStyle="{StaticResource PinTypeEditingStyle}"/>
                                <DataGridTextColumn Header="理想X" Binding="{Binding IdealOffsetX, StringFormat={}{0:F3}}" Width="100" ElementStyle="{StaticResource PinTypeTextColumnStyle}" EditingElementStyle="{StaticResource PinTypeEditingStyle}"/>
                                <DataGridTextColumn Header="理想Y" Binding="{Binding IdealOffsetY, StringFormat={}{0:F3}}" Width="100" ElementStyle="{StaticResource PinTypeTextColumnStyle}" EditingElementStyle="{StaticResource PinTypeEditingStyle}"/>
                                <DataGridTextColumn Header="高度偏差" Binding="{Binding HeightTolerance, StringFormat={}{0:F3}}" Width="100" ElementStyle="{StaticResource PinTypeTextColumnStyle}" EditingElementStyle="{StaticResource PinTypeEditingStyle}"/>
                                <DataGridTextColumn Header="理想高度" Binding="{Binding IdealHeight, StringFormat={}{0:F3}}" Width="100" ElementStyle="{StaticResource PinTypeTextColumnStyle}" EditingElementStyle="{StaticResource PinTypeEditingStyle}"/>
                                <DataGridTemplateColumn Header="操作" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#9166;" ToolTip="Z轴移到该针尖焦距"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Style="{StaticResource MoveButtonStyle}"
                                                    Click="BtnMoveToFocus_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- ========== 备注 ========== -->
                    <TextBlock Text="&#128221; 备注" Foreground="{DynamicResource ThemeText}" FontSize="14" FontWeight="Bold" Margin="0,20,0,10"/>
                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBox Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35"
                                 Background="{DynamicResource ThemePanelBg}"
                                 Foreground="{DynamicResource ThemeText}"
                                 BorderBrush="{DynamicResource ThemeBorder}"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 AcceptsReturn="False"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnOk" Content="确定" Style="{StaticResource CommonRadiusButtonStyle}" Click="BtnOk_Click" Margin="0,0,10,0"/>
                    <Button x:Name="btnCancel" Content="取消" Style="{StaticResource CommonRadiusButtonStyle}" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
