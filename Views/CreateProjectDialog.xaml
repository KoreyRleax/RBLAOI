<Window x:Class="RBLAOI.Views.CreateProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建方案" Height="340" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeText}">

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 程序名称 -->
        <Border Grid.Row="0" Background="{DynamicResource ThemePanelBg}" CornerRadius="5" Padding="10" Margin="0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="方案名称" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ThemeText}"/>
                <TextBox x:Name="txtProjectName" Grid.Column="1" Height="35"
                         Background="{DynamicResource ThemePanelBg}"
                         Foreground="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeBorder}"
                         VerticalContentAlignment="Center"
                         FontSize="14"/>
            </Grid>
        </Border>

        <!-- 板宽 -->
        <Border Grid.Row="1" Background="{DynamicResource ThemePanelBg}" CornerRadius="5" Padding="10" Margin="0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="板宽" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ThemeText}"/>
                <TextBox x:Name="txtBoardWidth" Grid.Column="1" Height="35"
                         Background="{DynamicResource ThemePanelBg}"
                         Foreground="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeBorder}"
                         VerticalContentAlignment="Center"
                         FontSize="14"/>
                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="10,0,0,0" 
                           Foreground="{DynamicResource ThemeTextSecondary}"/>
            </Grid>
        </Border>

        <!-- 板高 -->
        <Border Grid.Row="2" Background="{DynamicResource ThemePanelBg}" CornerRadius="5" Padding="10" Margin="0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="板高" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource ThemeText}"/>
                <TextBox x:Name="txtBoardHeight" Grid.Column="1" Height="35"
                         Background="{DynamicResource ThemePanelBg}"
                         Foreground="{DynamicResource ThemeText}"
                         BorderBrush="{DynamicResource ThemeBorder}"
                         VerticalContentAlignment="Center"
                         FontSize="14"/>
                <TextBlock Grid.Column="2" Text="mm" VerticalAlignment="Center" Margin="10,0,0,0" 
                           Foreground="{DynamicResource ThemeTextSecondary}"/>
            </Grid>
        </Border>

        <!-- 光源模板 -->
        <Border Grid.Row="3" Background="{DynamicResource ThemePanelBg}" CornerRadius="5" Padding="10" Margin="0,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="光源模板" VerticalAlignment="Center" FontSize="14" 
                           Foreground="{DynamicResource ThemeText}" Width="80"/>
                <ComboBox x:Name="cmbLightTemplate" Width="200" Height="32"
                          SelectedIndex="0"
                          Background="{DynamicResource ThemePanelBg}"
                          Foreground="{DynamicResource ThemeText}"
                          BorderBrush="{DynamicResource ThemeBorder}"
                          VerticalContentAlignment="Center"
                          FontSize="13">
                    <ComboBoxItem>Default</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Border>


        <!-- 按钮区域 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button x:Name="btnConfirm" Content="确定" Margin="0,0,10,0"
                    Background="{DynamicResource BtnSuccess}" Foreground="White"
                    Style="{StaticResource CommonRadiusButtonStyle}"
                    Click="BtnConfirm_Click"/>

            <Button x:Name="btnCancel" Content="取消"
                    Background="{DynamicResource ThemeTextSecondary}" Foreground="White"
                    Style="{StaticResource CommonRadiusButtonStyle}"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>