<Window x:Class="RBLAOI.Views.LightControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RBLAOI.Core.Controls"
        Title="光源控制" Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="620" MinWidth="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeText}">

    <Border Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <controls:TitleBarControl Grid.Row="0" Title="光源控制" TitleIcon="&#128161;"/>

            <StackPanel Grid.Row="1" Margin="20">

                    <!-- ========== 光源通道（串口号/波特率/通道数为系统参数，在 系统参数→连接管理 中配置） ========== -->
                    <TextBlock Text="&#128161; 光源通道" Foreground="{DynamicResource ThemeText}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="拖动滑块或直接输入数值（0-255），勾选为亮、取消勾选为灭" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="0,0,0,4"/>

                            <Grid x:Name="ChRow1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                          IsChecked="{Binding LightOn1, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="通道1：" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Foreground="{DynamicResource ThemeText}"/>
                                <Slider Grid.Column="2" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                        Value="{Binding Channel1, UpdateSourceTrigger=PropertyChanged}"
                                        IsMoveToPointEnabled="True"/>
                                <TextBox Grid.Column="3" Margin="12,0,0,0"
                                         Text="{Binding Channel1, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Center" Height="26"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         Background="{DynamicResource ThemePanelBg}"
                                         Foreground="{DynamicResource ThemeText}"
                                         BorderBrush="{DynamicResource ThemeBorder}"/>
                            </Grid>

                            <Grid x:Name="ChRow2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                          IsChecked="{Binding LightOn2, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="通道2：" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Foreground="{DynamicResource ThemeText}"/>
                                <Slider Grid.Column="2" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                        Value="{Binding Channel2, UpdateSourceTrigger=PropertyChanged}"
                                        IsMoveToPointEnabled="True"/>
                                <TextBox Grid.Column="3" Margin="12,0,0,0"
                                         Text="{Binding Channel2, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Center" Height="26"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         Background="{DynamicResource ThemePanelBg}"
                                         Foreground="{DynamicResource ThemeText}"
                                         BorderBrush="{DynamicResource ThemeBorder}"/>
                            </Grid>

                            <Grid x:Name="ChRow3" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                          IsChecked="{Binding LightOn3, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="通道3：" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Foreground="{DynamicResource ThemeText}"/>
                                <Slider Grid.Column="2" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                        Value="{Binding Channel3, UpdateSourceTrigger=PropertyChanged}"
                                        IsMoveToPointEnabled="True"/>
                                <TextBox Grid.Column="3" Margin="12,0,0,0"
                                         Text="{Binding Channel3, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Center" Height="26"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         Background="{DynamicResource ThemePanelBg}"
                                         Foreground="{DynamicResource ThemeText}"
                                         BorderBrush="{DynamicResource ThemeBorder}"/>
                            </Grid>

                            <Grid x:Name="ChRow4" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                          IsChecked="{Binding LightOn4, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="通道4：" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Foreground="{DynamicResource ThemeText}"/>
                                <Slider Grid.Column="2" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                        Value="{Binding Channel4, UpdateSourceTrigger=PropertyChanged}"
                                        IsMoveToPointEnabled="True"/>
                                <TextBox Grid.Column="3" Margin="12,0,0,0"
                                         Text="{Binding Channel4, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Center" Height="26"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         Background="{DynamicResource ThemePanelBg}"
                                         Foreground="{DynamicResource ThemeText}"
                                         BorderBrush="{DynamicResource ThemeBorder}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========== 训练拍照（临时功能：不同光源/曝光下采集训练图，不影响瓦片） ========== -->
                    <TextBlock Text="&#128247; 训练拍照" Foreground="{DynamicResource ThemeText}" FontSize="14" FontWeight="Bold" Margin="0,20,0,10"/>
                    <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="曝光时间拖动滑块实时下发（0-30000μs），拍照存到独立目录" Foreground="{DynamicResource ThemeSubText}" FontSize="11" Margin="0,0,0,4"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="曝光时间：" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Foreground="{DynamicResource ThemeText}"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="30000" VerticalAlignment="Center"
                                        Value="{Binding ExposureValue, UpdateSourceTrigger=PropertyChanged}"
                                        IsMoveToPointEnabled="True"/>
                                <TextBox Grid.Column="2" Margin="12,0,0,0"
                                         Text="{Binding ExposureValue, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Center" Height="26"
                                         PreviewTextInput="NumberOnly_PreviewTextInput"
                                         Background="{DynamicResource ThemePanelBg}"
                                         Foreground="{DynamicResource ThemeText}"
                                         BorderBrush="{DynamicResource ThemeBorder}"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="存储路径：" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Foreground="{DynamicResource ThemeText}"/>
                                <TextBox Grid.Column="1" Height="26" IsReadOnly="True"
                                         Text="{Binding TrainDir, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Left" VerticalContentAlignment="Center"
                                         Background="{DynamicResource ThemePanelBg}"
                                         Foreground="{DynamicResource ThemeText}"
                                         BorderBrush="{DynamicResource ThemeBorder}"/>
                                <Button Grid.Column="2" Content="浏览..." Margin="12,0,0,0" Height="26"
                                        Style="{StaticResource CommonRadiusButtonStyle}" Click="BtnBrowseDir_Click"/>
                            </Grid>

                            <Button x:Name="BtnTrainCapture" Content="&#128247; 拍照（按当前光源+曝光保存到训练目录）" Margin="0,14,0,0" Height="34"
                                    Click="BtnTrainCapture_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CommonRadiusButtonStyle}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FF5A8F6A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
            </StackPanel>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="确定" Style="{StaticResource CommonRadiusButtonStyle}" Click="BtnOk_Click" Margin="0,0,10,0"/>
                    <Button Content="取消" Style="{StaticResource CommonRadiusButtonStyle}" Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
