<Window x:Class="RBLAOI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
        xmlns:controls="clr-namespace:RBLAOI.Core.Controls"
        xmlns:views="clr-namespace:RBLAOI"
        Title="AOI 视觉检测系统"
        Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBg}"
        ContentRendered="Window_ContentRendered"
        Closing="Window_Closing"
         WindowStyle="None"
        WindowState="Maximized">

    <!-- 应用图标资源（2026-08-19：主界面顶部栏未应用图标的修复）
         TitleBarControl 的 IconSource 非空时显示图片、空时显示 TitleIcon 表情；
         MainWindow 显式绑定 AppIcon，顶部栏显示应用图标；子窗口的 TitleBarControl
         未设 IconSource，仍显示各窗口的表情图标（有意设计，不受本资源影响）。 -->
    <Window.Resources>
        <BitmapImage x:Key="AppIcon" UriSource="pack://application:,,,/Assets/AppIcon.png"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>


        <controls:TitleBarControl Grid.Row="0"
                          Title="AOI 视觉检测系统"
                          IconSource="{StaticResource AppIcon}"/>

        <!-- 主菜单栏（横向排列，带图标和间距） -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeTitleBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0">
                <!-- 文件菜单 -->
                <Button x:Name="btnFile"  Style="{DynamicResource NavMenuButtonActiveStyle}" Tag="file" Margin="0,0,15,0" 
                        Click="MainMenu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="14"/>
                        <TextBlock Text="文件"/>
                    </StackPanel>
                </Button>

                <!-- 编辑菜单 -->
                <Button x:Name="btnEdit"  Style="{DynamicResource NavMenuButtonStyle}" Tag="edit" Margin="0,0,15,0"
                        Click="MainMenu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" FontSize="14" />
                        <TextBlock Text="编辑"/>
                    </StackPanel>
                </Button>

                <!-- 功能菜单 -->
                <Button x:Name="btnFunction"  Style="{DynamicResource NavMenuButtonStyle}" Tag="function" Margin="0,0,15,0"
                        Click="MainMenu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔧" FontSize="14" />
                        <TextBlock Text="功能"/>
                    </StackPanel>
                </Button>

                <!-- 运行菜单 -->
                <Button x:Name="btnRun"  Style="{DynamicResource NavMenuButtonStyle}" Tag="run" Margin="0,0,15,0"
                        Click="MainMenu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶️" FontSize="14" />
                        <TextBlock Text="运行"/>
                    </StackPanel>
                </Button>

                <!-- 设置菜单 -->
                <Button x:Name="btnSetting"  Style="{DynamicResource NavMenuButtonStyle}" Tag="setting" Margin="0,0,15,0"
                        Click="MainMenu_Click" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" FontSize="14" />
                        <TextBlock Text="设置"/>
                    </StackPanel>
                </Button>

                <!-- 帮助菜单 -->
                <Button x:Name="btnHelp"  Style="{DynamicResource NavMenuButtonStyle}" Tag="help" Margin="0,0,15,0"
                        Click="MainMenu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="❓" FontSize="14" />
                        <TextBlock Text="帮助"/>
                    </StackPanel>
                </Button>

                <!-- 右侧分隔线 -->
                <Rectangle Width="1" Height="24" Fill="{DynamicResource ThemeBorder}" Margin="0,0,12,0"/>
            </StackPanel>
        </Border>

        <!-- ==================== 子菜单工具栏（功能按钮横向排列） ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：子菜单按钮区域 -->
            <Border Grid.Column="0" Background="{DynamicResource ThemePanelBg}" 
            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Disabled"  
                      CanContentScroll="False">
                    <StackPanel x:Name="SubMenuPanel" Orientation="Horizontal" Margin="12,6">
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧：固定按钮区（开始/停止/复位/归零），风格仿IO面板快捷按钮但更大、圆角 -->
            <Border Grid.Column="1" Background="{DynamicResource ThemePanelBg}"
            BorderBrush="{DynamicResource ThemeBorder}"
            BorderThickness="1,0,0,1"
            Margin="0,0,0,0">
                <UniformGrid Columns="4" Rows="1" Margin="6,3">
                    <Button x:Name="btnFixedStart" Tag="start_resume" Content="开始" Height="46" Margin="3"
                            Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}"
                            FontFamily="楷体" FontSize="30"
                            Click="SubMenuButton_Click" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="btnFixedStop" Tag="stop_work" Content="停止" Height="46" Margin="3"
                            Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}"
                            FontFamily="楷体" FontSize="30"
                            Click="SubMenuButton_Click" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="btnFixedReset" Tag="reset_machine" Content="复位" Height="46" Margin="3"
                            Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}"
                            FontFamily="楷体" FontSize="30"
                            Click="SubMenuButton_Click" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <Button x:Name="btnFixedHome" Tag="home_all" Content="归零" Height="46" Margin="3"
                            Background="{StaticResource ThemeButton}" Foreground="{StaticResource ThemeText}"
                            FontFamily="楷体" FontSize="30"
                            Click="SubMenuButton_Click" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>

        <!-- ==================== 主内容区域 ==================== -->
        <Grid Grid.Row="3" Margin="5,0,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧 Halcon 图像显示区域 -->
            <Border Grid.Column="0" Margin="0,2,0,2">
                <Grid>
                    <Border Background="#FF1A1A1A" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 标记工具栏 + 查看工具栏 -->
                            <Border Grid.Row="0" Background="Transparent" Margin="4,2,4,0"
                                    BorderThickness="0" Height="Auto">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 标记工具栏（由代码动态生成） -->
                                    <StackPanel x:Name="MarkerToolbar" Orientation="Horizontal">
                                        <!-- 标记按钮 A,B,C... 将由代码动态生成 -->
                                    </StackPanel>

                                    <!-- 分隔线 -->
                                    <Separator Width="1" Height="20" Background="#505050" Margin="4,0"/>

                                    <!-- 查看模式工具栏（由代码动态生成） -->
                                    <StackPanel x:Name="ViewToolbar" Orientation="Horizontal">
                                        <!-- 查看按钮由代码动态生成 -->
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <controls:CustomHSmartWindowControl Grid.Row="1" x:Name="MainHWindow" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧信息面板 -->
            <Grid Grid.Column="1">
                <TabControl x:Name="tabControl" SelectedIndex="{Binding SelectedTabIndex}" Margin="4,0,0,2"
                Background="{DynamicResource ThemePanelBg}"
                BorderBrush="{DynamicResource ThemeBorder}"
                Style="{StaticResource ThemedTabControlStyle}">

                <!-- ==================== 主视图 ==================== -->
                <TabItem Margin="10,0,-10,0"  Header="主视图" >
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Border Grid.Column="1" Style="{DynamicResource PanelStyle}" Margin="0,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12">

                                        <!-- ==================== PCB 信息 ==================== -->
                                        <TextBlock Text="📦 PCB 信息" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <!-- PCB 信息表格 -->
                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 0 方案名称 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 1 文件路径 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 2 板宽 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 3 板高 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 4 FOV宽 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 5 FOV高 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 6 重叠率 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 7 子基板数 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 8 当前面 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 9 当前批次 -->
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- 10 备注 -->
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 方案名称 (Row 0) -->
                                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="方案名称" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource ThemePanelBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding CurrentProjectName}"
               Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="SemiBold" Margin="4,0"/>
                                                </Border>

                                                <!-- 文件路径 (Row 1) -->
                                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="文件路径" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBox Text="{Binding CurrentProjectPath, Mode=OneWay}" 
               VerticalContentAlignment="Center" Background="Transparent" 
               Foreground="{DynamicResource ThemeText}" BorderThickness="0" 
               FontSize="11" IsReadOnly="True" 
               HorizontalAlignment="Left" TextAlignment="Left"/>
                                                </Border>

                                                <!-- 板宽 (Row 2) -->
                                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="板宽 (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding BoardWidth, StringFormat={}{0:0.##}}"
               Foreground="{DynamicResource ThemeText}" FontSize="12" Margin="4,0"/>
                                                </Border>

                                                <!-- 板高 (Row 3) -->
                                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="板高 (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="3" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding BoardHeight, StringFormat={}{0:0.##}}"
               Foreground="{DynamicResource ThemeText}" FontSize="12" Margin="4,0"/>
                                                </Border>

                                                <!-- FOV宽 (Row 4) -->
                                                <Border Grid.Row="4" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="FOV宽 (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="4" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding FovWidth, StringFormat={}{0:F2}}"
               Foreground="{DynamicResource ThemeText}" FontSize="12" Margin="4,0"/>
                                                </Border>

                                                <!-- FOV高 (Row 5) -->
                                                <Border Grid.Row="5" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="FOV高 (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="5" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding FovHeight, StringFormat={}{0:F2}}"
               Foreground="{DynamicResource ThemeText}" FontSize="12" Margin="4,0"/>
                                                </Border>

                                                <!-- 重叠率 (Row 6) -->
                                                <Border Grid.Row="6" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="重叠率 (%)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="6" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding Overlap}"
               Foreground="{DynamicResource ThemeText}" FontSize="12" Margin="4,0"/>
                                                </Border>

                                                <!-- 子基板数 (Row 7) -->
                                                <Border Grid.Row="7" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="子基板数" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="7" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding SubBoardCount}"
               Foreground="{DynamicResource ThemeText}" FontSize="12" Margin="4,0"/>
                                                </Border>

                                                <!-- 当前面 (Row 8) -->
                                                <Border Grid.Row="8" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="当前面" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="8" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding CurrentSide}"
               Foreground="{DynamicResource ThemeText}" FontSize="12" Margin="4,0"/>
                                                </Border>

                                                <!-- 当前批次 (Row 9) -->
                                                <Border Grid.Row="9" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="当前批次" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                    <Border Grid.Row="9" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding CurrentBatch}"
               Foreground="{DynamicResource ThemeText}" FontSize="12" Margin="4,0"/>
                                                </Border>

                                                <!-- 备注 (Row 10) -->
                                                <Border Grid.Row="10" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="8,6">
                                                    <TextBlock Text="备注" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="10" Grid.Column="1" Padding="8,6">
                                                    <TextBox Text="{Binding Remark, Mode=OneWay}"
               VerticalContentAlignment="Center" Background="Transparent"
               Foreground="{DynamicResource ThemeText}" BorderThickness="0"
               FontSize="12" IsReadOnly="True"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- ==================== 检测参数 ==================== -->
                                        <TextBlock Text="📏 检测参数" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" Margin="0,16,0,10"/>

                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- X偏差 -->
                                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="X偏差 (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding ProjectXAllowedDeviation, StringFormat={}{0:F3}}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsXDevModified}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Y偏差 -->
                                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="Y偏差 (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding ProjectYAllowedDeviation, StringFormat={}{0:F3}}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsYDevModified}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- 理想针高 -->
                                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="理想针高 (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding ProjectIdealPinHeight, StringFormat={}{0:F3}}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHeightModified}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- 允许高度差 -->
                                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="8,6">
                                                    <TextBlock Text="高度差 (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="3" Grid.Column="1" Padding="8,6">
                                                    <TextBlock Text="{Binding ProjectAllowedHeightDeviation, StringFormat={}{0:F3}}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHeightDevModified}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- 相对焊盘偏移X -->
                                                <Border Grid.Row="4" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="8,6">
                                                    <TextBlock Text="偏移X (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="4" Grid.Column="1" Padding="8,6">
                                                    <TextBlock Text="{Binding ProjectRelativeOffsetX, StringFormat={}{0:F3}}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRelOffsetXModified}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- 相对焊盘偏移Y -->
                                                <Border Grid.Row="5" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="8,6">
                                                    <TextBlock Text="偏移Y (mm)" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="5" Grid.Column="1" Padding="8,6">
                                                    <TextBlock Text="{Binding ProjectRelativeOffsetY, StringFormat={}{0:F3}}" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRelOffsetYModified}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFFF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- ==================== 检测结果 ==================== -->
                                        <TextBlock Text="📊 检测结果" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" Margin="0,16,0,10"/>

                                        <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 良品数 -->
                                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="良品数" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding GoodCount}" Foreground="#FF4ECDC4" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Border>

                                                <!-- 不良品 -->
                                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="不良品" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding NgCount}" Foreground="#FFFF6B6B" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Border>

                                                <!-- 良率 -->
                                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="良率" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding YieldRate, StringFormat={}{0:F2}%}" Foreground="{DynamicResource TextInfo}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Border>

                                                <!-- 直通率 -->
                                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,1" Padding="8,6">
                                                    <TextBlock Text="直通率" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="3" Grid.Column="1" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="8,6">
                                                    <TextBlock Text="{Binding PassRate, StringFormat={}{0:F2}%}" Foreground="{DynamicResource ThemeText}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                </Border>

                                                <!-- 检测时间 -->
                                                <Border Grid.Row="4" Grid.Column="0" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,1,0" Padding="8,6">
                                                    <TextBlock Text="检测时间" Foreground="{DynamicResource ThemeSubText}" FontSize="12"/>
                                                </Border>
                                                <Border Grid.Row="4" Grid.Column="1" Padding="8,6">
                                                    <TextBlock Text="{Binding InspectTime, StringFormat={}{0:F2}s}" Foreground="{DynamicResource ThemeText}" FontSize="12" HorizontalAlignment="Right"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ==================== 拍照位列表 ==================== -->
                <TabItem  Margin="10,0,-10,0" Header="拍照位">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="拍照位列表" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1" x:Name="dgGrabPositions"
                           Style="{StaticResource ThemedDataGridStyle}"
                          SelectionMode="Single"
                          ItemsSource="{Binding GrabPositions}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="位" Binding="{Binding Index}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="50"/>
                                <DataGridTextColumn Header="行" Binding="{Binding Row}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="50"/>
                                <DataGridTextColumn Header="列" Binding="{Binding Col}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="50"/>
                                <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat={}{0:F2}}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="100"/>
                                <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat={}{0:F2}}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="100"/>
                                <DataGridCheckBoxColumn Header="检测位" Binding="{Binding IsDetectPosition, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource DataGridCheckBoxStyle}" EditingElementStyle="{StaticResource DataGridCheckBoxStyle}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ==================== 检测位视图 ==================== -->
                <TabItem Margin="10,0,-10,0" Header="检测位">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="检测位列表" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1" x:Name="dgInspectionPoints"
                        Style="{StaticResource ThemedDataGridStyle}"
                          SelectionMode="Single"
                          ItemsSource="{Binding DetectPositions}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="位" Binding="{Binding Index}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="50"/>
                                <DataGridTextColumn Header="拍照位" Binding="{Binding GrabIndex}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="70"/>
                                <DataGridTextColumn Header="行" Binding="{Binding Row}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="50"/>
                                <DataGridTextColumn Header="列" Binding="{Binding Col}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="50"/>
                                <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat={}{0:F2}}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="100"/>
                                <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat={}{0:F2}}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ==================== 检测结果 ==================== -->
                <TabItem Margin="10,0,-10,0" Header="检测结果">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 2026-08-27 Bug修复2：检测总数（去重后）显示在列表标题旁，运行时/加载历史结果后均更新 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="检测结果列表" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" Margin="0,0,12,10"/>
                            <TextBlock Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                <Run Text="检测总数："/><Run Text="{Binding TotalPinCount}"/>
                            </TextBlock>
                            <!-- 2026-08-27：检测耗时（开始检测计时，运行中每1s刷新；暂停停走；正常结束保留本次耗时；中断重置为0） -->
                            <TextBlock Foreground="{DynamicResource ThemeTextSecondary}" FontSize="12" VerticalAlignment="Bottom" Margin="16,0,0,10">
                                <Run Text="检测耗时："/><Run Text="{Binding InspectElapsed, StringFormat='{}{0:hh\\:mm\\:ss}'}"/>
                            </TextBlock>
                        </StackPanel>

                        <DataGrid Grid.Row="1" x:Name="dgPinResults"
                        Style="{StaticResource ThemedDataGridStyle}"
                          SelectionMode="Single"
                          ItemsSource="{Binding PinResults}"
                          ContextMenuOpening="dgPinResults_ContextMenuOpening">
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeActive}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Result}" Value="NG">
                                            <Setter Property="Foreground" Value="#FFFF4444"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Result}" Value="OK">
                                            <Setter Property="Foreground" Value="#FF44CC44"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="pinId" Binding="{Binding PINID}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="70"/>
                                <DataGridTextColumn Header="kind" Binding="{Binding PinType}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="45"/>
                                <DataGridTextColumn Header="dx" Binding="{Binding DiffX}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn Header="dy" Binding="{Binding DiffY}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn Header="h" Binding="{Binding H, StringFormat={}{0:F3}}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="70"/>
                                <DataGridTextColumn Header="rs" Binding="{Binding Result}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="45"/>
                                <DataGridTextColumn Header="pinX" Binding="{Binding X, StringFormat={}{0:F2}}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn Header="pinY" Binding="{Binding Y, StringFormat={}{0:F2}}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn Header="padX" Binding="{Binding PadX, StringFormat={}{0:F2}}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="70"/>
                                <DataGridTextColumn Header="padY" Binding="{Binding PadY, StringFormat={}{0:F2}}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="70"/>
                                <DataGridTextColumn Header="pos" Binding="{Binding DetectIndex}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="50"/>
                                <DataGridTextColumn Header="pinIdx" Binding="{Binding PinIndex}" ElementStyle="{StaticResource DataGridTextColumnStyle}" IsReadOnly="True" Width="55"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            </Grid>



        </Grid>

        <!-- ==================== 底部状态栏：状态 | 运行信息 | 报警信息 三段，状态文字动态变色(报警→红，未就绪→黄，其余→绿)，DispatcherTimer 定时刷新 ==================== -->
        <Border Grid.Row="4" Height="28" Background="{DynamicResource ThemeBottomStatus}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtDeviceState" Foreground="#FF558B2F"  Margin="20,0,10,0" FontSize="18" FontWeight="Bold" Text="就绪" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Width="2" Background="#FAFAFA" Opacity="0.85" VerticalAlignment="Stretch"/>
                <TextBlock Grid.Column="2" x:Name="txtInfo" Foreground="#FF558B2F" Margin="10,0,10,0" FontSize="18" FontWeight="Bold" Text="" VerticalAlignment="Center"/>
                <Border Grid.Column="3" Width="2" Background="#FAFAFA" Opacity="0.85" VerticalAlignment="Stretch"/>
                <TextBlock Grid.Column="4" x:Name="txtAlarm" Foreground="#FFFF0000" Margin="10,0,0,0" FontSize="18" FontWeight="Bold" Text="" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>