<Window x:Class="RBLAOI.Views.PrecisionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RBLAOI.Core.Controls"
        Title="精度检测报告" Height="820" Width="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource ThemeBg}"
        Foreground="{DynamicResource ThemeText}">

    <Window.Resources>
        <Style x:Key="StatBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="12,8,12,4"/>
        </Style>
        <Style x:Key="DetailHeaderCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DetailCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="240"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <controls:TitleBarControl x:Name="titleBar" Grid.Row="0" Title="精度检测报告" TitleIcon="📊"/>

            <!-- 汇总区 -->
            <Border Grid.Row="1" Margin="12,8,12,4" Padding="12,8"
                    Background="{DynamicResource ThemePanelBg}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="检测次数" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalRuns" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="匹配针数" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtTotalPins" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="耗时" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtDuration" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="σdx 均值" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtAvgDxStd" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="#4FC3F7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <TextBlock Text="σdy 均值" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtAvgDyStd" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="#4FC3F7"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                        <TextBlock Text="σh 均值" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtAvgHStd" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="#CE93D8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2026-08-27 (f)：极差分布统计表（按针型细分：行=等级，列=全部+A/B/C...） -->
            <StackPanel Grid.Row="2">
                <TextBlock Text="极差分布统计（按针型，良好→严重）" Style="{StaticResource SectionLabelStyle}"/>
                <Border Margin="12,0,12,0" Padding="0"
                        Background="{DynamicResource ThemePanelBg}"
                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4">
                    <Grid x:Name="kindRangeGrid"/>
                </Border>
            </StackPanel>

            <!-- 2026-08-27 (e)：汇总明细表（id kind Pos X Y σdx σdy σh ∂dx ∂dy ∂h） -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="汇总（id kind Pos X Y ˉdx ˉdy ˉh ∂dx ∂dy ∂h）" Style="{StaticResource SectionLabelStyle}"/>
                <DataGrid x:Name="dgStats" Grid.Row="1"
                          Margin="12,0,12,4"
                          Background="{DynamicResource ThemeBg}"
                          Foreground="{DynamicResource ThemeText}"
                          BorderBrush="{DynamicResource ThemeBorder}"
                          BorderThickness="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          FontSize="12"
                          EnableRowVirtualization="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource ThemePanelBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Height" Value="28"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="4,0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                            <Setter Property="Height" Value="24"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="id" Width="50" Binding="{Binding Seq}"/>
                        <DataGridTextColumn Header="kind" Width="50" Binding="{Binding PinType}"/>
                        <DataGridTextColumn Header="Pos" Width="60" Binding="{Binding DetectIndex}"/>
                        <DataGridTextColumn Header="X" Width="80" Binding="{Binding X, StringFormat={}{0:F3}}"/>
                        <DataGridTextColumn Header="Y" Width="80" Binding="{Binding Y, StringFormat={}{0:F3}}"/>
                        <DataGridTextColumn Header="ˉdx" Width="80" Binding="{Binding DxStdDev, StringFormat={}{0:F4}}"/>
                        <DataGridTextColumn Header="ˉdy" Width="80" Binding="{Binding DyStdDev, StringFormat={}{0:F4}}"/>
                        <DataGridTextColumn Header="ˉh" Width="80" Binding="{Binding HStdDev, StringFormat={}{0:F4}}"/>
                        <DataGridTextColumn Header="∂dx" Width="80" Binding="{Binding DxRange, StringFormat={}{0:F4}}"/>
                        <DataGridTextColumn Header="∂dy" Width="80" Binding="{Binding DyRange, StringFormat={}{0:F4}}"/>
                        <DataGridTextColumn Header="∂h" Width="80" Binding="{Binding HRange, StringFormat={}{0:F4}}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- 2026-08-27 (d)：每轮明细（每针一块：id kind Pos X Y 独占单元格 + 对齐 N 行 dx dy h） -->
            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="每轮明细（共 " Style="{StaticResource SectionLabelStyle}" Margin="12,8,0,4"/>
                    <TextBlock x:Name="txtDetailCount" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,4"/>
                    <TextBlock Text=" 针）" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,4"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="12,0,12,4"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="lvDetails">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1" Padding="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧：id kind Pos X Y 独占一个单元格（垂直居中对齐右侧 N 行） -->
                                        <Border Grid.Column="0" Margin="0,0,10,0" Padding="6,4"
                                                Background="{DynamicResource ThemePanelBg}"
                                                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="{Binding Header}"
                                                       Foreground="{DynamicResource ThemeText}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 右侧：每轮一行 dx dy h -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="轮" Style="{StaticResource DetailHeaderCellStyle}"/>
                                                <TextBlock Grid.Column="1" Text="dx" Style="{StaticResource DetailHeaderCellStyle}"/>
                                                <TextBlock Grid.Column="2" Text="dy" Style="{StaticResource DetailHeaderCellStyle}"/>
                                                <TextBlock Grid.Column="3" Text="h" Style="{StaticResource DetailHeaderCellStyle}"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="18">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="70"/>
                                                                <ColumnDefinition Width="70"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Run}" Style="{StaticResource DetailCellStyle}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Dx}" Style="{StaticResource DetailCellStyle}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Dy}" Style="{StaticResource DetailCellStyle}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding H}" Style="{StaticResource DetailCellStyle}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 底部按钮 -->
            <Border Grid.Row="5" Padding="12,8" Background="{DynamicResource ThemeBg}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnExport" Content="导出 CSV" Style="{StaticResource CommonRadiusButtonStyle}"
                            Background="{StaticResource BtnSuccess}" Margin="0,0,8,0" Click="BtnExport_Click"/>
                    <Button Content="关闭" Style="{StaticResource CommonRadiusButtonStyle}"
                            Background="{DynamicResource ThemeBorder}" Click="BtnClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
