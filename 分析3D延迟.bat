@echo off
chcp 65001 >nul
cd /d "%~dp0"
echo ============================================================
echo  3D检测延迟分析工具（只读已有日志，不会触发检测）
echo  使用步骤: 先在上位机运行一轮检测 → 再运行本工具
echo  默认分析最新 1 个日志；参数: 分析3D延迟.bat [关键字] [数量]
echo    例: 分析3D延迟.bat 20260820   只分析今天的日志
echo        分析3D延迟.bat . 0        分析全部日志
echo ============================================================
echo.
python analyze_3d_delay.py bin\x64\Debug\logs %1 %2
echo.
pause
