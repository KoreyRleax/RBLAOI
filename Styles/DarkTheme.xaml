<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CommonStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== 主题资源（供界面绑定） ==================== -->
    <SolidColorBrush x:Key="ThemeBg" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="ThemeTitleBg" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="ThemePanelBg" Color="#252526"/>
    <SolidColorBrush x:Key="ThemePanel1Bg" Color="#121212"/>


    <SolidColorBrush x:Key="ThemeBorder" Color="#3c3c3c"/>
    <SolidColorBrush x:Key="ThemeSubBorder" Color="#5a5a5a"/>
    <SolidColorBrush x:Key="ThemeText" Color="#f5f5f5"/>
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#FF858585"/>
    <SolidColorBrush x:Key="ThemeSubText" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="ThemeHover" Color="#3d3d3d"/>
    <SolidColorBrush x:Key="ThemeActive" Color="#0aa6d8"/>
    <SolidColorBrush x:Key="ThemeButton" Color="#2f3134"/>
    <SolidColorBrush x:Key="ThemeBottomStatus" Color="#861b2d"/>
    <SolidColorBrush x:Key="WhiteOrBlack" Color="#ffffff"/>


    <SolidColorBrush x:Key="ThemeDataGridHead" Color="#1863da"/>
    <SolidColorBrush x:Key="ThemeDataGridRow1" Color="#c0c0c0"/>
    <SolidColorBrush x:Key="ThemeDataGridRow2" Color="#f2f2f2"/>

    <!-- ==================== 背景渐变色 ==================== -->
    <LinearGradientBrush x:Key="ThemeGradientBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1E1E1E" Offset="0"/>
        <GradientStop Color="#FF2A2A2A" Offset="0.5"/>
        <GradientStop Color="#FF252526" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CyanGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00D4FF" Offset="0"/>
        <GradientStop Color="#FF0088AA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF9B4DFF" Offset="0"/>
        <GradientStop Color="#FF6B2EFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ==================== 阴影效果 ==================== -->
    <DropShadowEffect x:Key="GlowEffect" Color="#FF00D4FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="CardShadow" Color="#FF000000" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>



</ResourceDictionary>